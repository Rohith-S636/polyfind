# App
NODE_ENV=development
APP_URL=http://localhost:3000
CATALOG_MODE=demo
API_PORT=3001
PORT=3000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=120

# MySQL (authoritative relational data)
DATABASE_URL=mysql://polyfind:change-me@localhost:3306/polyfind

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# LanceDB derived vector index
VECTOR_STORE_PROVIDER=
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE=product_embeddings

# OpenAI-compatible embeddings provider
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_API_KEY=

# Auth / application secrets
AUTH_SECRET=replace-with-local-random-secret
