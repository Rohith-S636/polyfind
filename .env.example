# PolyFind local development configuration.
# Copy to .env and keep all real secrets out of Git.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
CATALOG_MODE=demo
API_PORT=3001
PORT=3000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=120

# MySQL (authoritative source of truth; local Docker credentials only)
MYSQL_PASSWORD=replace-with-random-local-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
DATABASE_URL=mysql://polyfind:replace-with-random-local-password@localhost:3306/polyfind

# Redis cache
REDIS_URL=redis://localhost:6379

# Neo4j graph projection (local Docker credentials only; NEO4J_AUTH and NEO4J_PASSWORD must match)
NEO4J_AUTH=neo4j/replace-with-random-neo4j-password
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-random-neo4j-password
NEO4J_DATABASE=neo4j

# LanceDB embedded vector index
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE=product_embeddings
POLYFIND_LOCAL_EMBEDDINGS=true

# Optional OpenAI-compatible embedding service. If these are blank,
# PolyFind uses its deterministic local feature-hashing vectorizer.
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=384
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_API_KEY=

# One-time administrator bootstrap token: generate 32+ random characters.
# Remove it from the deployment environment after the first admin is created.
AUTH_BOOTSTRAP_TOKEN=
